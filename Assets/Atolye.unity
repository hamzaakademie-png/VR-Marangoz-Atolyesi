  urunler:
  - ad: "Ah\u015Fap An\u0131t"
    alet: Oyma Keskisi
    aciklama: "Bayrakl\u0131, kaz\u0131klardan yap\u0131lm\u0131\u015F k\xFC\xE7\xFCk bir ah\u015Fap an\u0131t. Kaz\u0131klar\u0131n aras\u0131 keskiyle oyulur"
    model: {fileID: 519096979}
    resim: {fileID: 0}
  - ad: "Satran\xE7 Piyonu"
    alet: "T\xF6rp\xFC"
    aciklama: "Klasik bir piyon. K\xFCt\xFCk t\xF6rp\xFCyle yuvarlat\u0131larak \u015Fekillendirilir."
    model: {fileID: 897182003}
    resim: {fileID: 0}
  - ad: Kale Maketi
    alet: "Oyma B\u0131\xE7a\u011F\u0131"
    aciklama: "\"Bayrakl\u0131 k\xFC\xE7\xFCk bir ah\u015Fap kale maketi. \u0130nce detaylar\u0131 oyma b\u0131\xE7a\u011F\u0131yla i\u015Flenir"
    model: {fileID: 66524836}
    resim: {fileID: 0}
  - ad: "\u0130skele Kul\xFCbesi"
    alet: "\xC7eki\xE7"
    aciklama: "Tahta platform \xFCst\xFCnde bir depo kul\xFCbesi. Tahtalar \xE7eki\xE7le \xE7ak\u0131larak birle\u015Ftirilir."
    model: {fileID: 1341777851}
    resim: {fileID: 0}
